/* SpotiFLAC's terminal UI, styled after MovieBox-Tui.

   Everything is a theme variable, never a literal: MovieBox reads its
   palette rather than hard-coding Catppuccin, which is why all nine of its
   themes look deliberate instead of one looking right and eight looking
   tinted. `t` cycles them, and every rule below follows.

   The grammar, in four parts: rounded borders on everything that is a panel;
   titles decorated as `─ ✦  Name` with an accent tag on the right; selection
   as bold text on a raised surface rather than an inverted bar; and badges —
   a short label on a solid colour, with contrasting text. */

Screen {
    background: $background;
}

/* ── Wordmark ──────────────────────────────────────────────────────── */

#banner {
    width: 100%;
    height: auto;
    padding-top: 1;
    background: $background;
}

#wordmark {
    width: 100%;
    text-align: center;
    color: $primary;
    text-style: bold;
}

#wordmark-subtitle {
    width: 100%;
    text-align: left;
    color: $text-muted;
}

.banner-plain #wordmark {
    text-style: bold;
}

/* ── Frame ─────────────────────────────────────────────────────────── */

#body {
    height: 1fr;
    padding: 0 1;
}

#sidebar {
    width: 26;
    height: 100%;
    padding: 1 1;
    border: round $panel;
    border-title-align: left;
    background: $surface;
}

/* Three rows a mode, not one. Eight single-row entries in a 22-column
   column read as a table of contents; the nav you steer the whole app
   with should be the second thing you see after the wordmark. */
#sidebar > ListItem {
    height: 3;
    padding: 1 1;
    background: $surface;
    color: $text-muted;
}

/* …but a 24-row terminal has about 14 rows of body, and eight three-row
   entries do not fit in that. Below the threshold the nav goes back to one
   row a mode, the same trade the wordmark makes. The class is set from
   `SpotiFLACTui.on_resize`, which is the only thing that knows the height. */
#sidebar.sidebar-compact {
    width: 22;
    padding: 0 1;
}

#sidebar.sidebar-compact > ListItem {
    height: 1;
    padding: 0 1;
}

/* Selection: bold on a raised surface, not an inverted bar. */
/* `padding: 1 1 1 0`, not `padding-left: 0` — Textual's `padding-left`
   resets the whole box rather than the one edge, which dropped the label of
   the selected row to the top of its three while every other row kept its
   text centred. The left edge goes to 0 so the accent bar has a column. */
#sidebar > ListItem.-highlight {
    background: $panel;
    color: $text;
    text-style: bold;
    border-left: thick $accent;
    padding: 1 1 1 0;
}

#sidebar.sidebar-compact > ListItem.-highlight {
    padding: 0 1 0 0;
}

#main {
    width: 1fr;
}

#panels {
    height: 1fr;
}

/* Every panel is a rounded card with a decorated title. */
#panels > * {
    border: round $panel;
    border-title-align: left;
    border-subtitle-align: right;
    padding: 1 2;
    background: $surface;
}

/* The pane the keyboard is pointing at. MovieBox lights its border and
   fills the dot in its title; the two together say it twice, which is the
   point — a highlight you have to hunt for is not a highlight. */
#panels > *:focus-within {
    border: round $accent;
}

/* ── Settings form ─────────────────────────────────────────────────── */

.setting-row {
    height: auto;
    margin-bottom: 1;
}

/* No fixed gutter. The label sits on its own line above the control (or
   after the switch it belongs to), so it is as wide as its words and the
   control gets the panel. */
.setting-label {
    width: auto;
    color: $text-muted;
}

.setting-line {
    height: auto;
}

/* The switch is three rows tall — its words have to drop to the middle one
   or they read as the label of the row above. */
.setting-row-switch .setting-label,
.setting-row-switch .setting-hint {
    padding-top: 1;
}

.setting-row-switch Switch {
    margin-right: 1;
}

.setting-hint {
    padding-left: 2;
    color: $text-disabled;
    text-style: italic;
}

/* Two columns, always — the marker changes glyph as a field is answered,
   never width, so the labels do not shuffle sideways while you type. */
.setting-mark {
    width: 2;
    color: $success;
}

.setting-mark.unmet {
    color: $warning;
    text-style: bold;
}

/* One width for every field. They were coming out 52, 33 and 52 columns
   depending on placeholder length, which read as accidental — because it
   was. The max keeps a full-width input from becoming a 90-column ribbon. */
.setting-row Input,
.setting-row Select {
    width: 1fr;
    max-width: 72;
}

Input {
    border: round $panel-lighten-1;
    background: $boost;
}

Input:focus {
    border: round $accent;
}

Select > SelectCurrent {
    border: round $panel-lighten-1;
}

SelectionList,
OptionList {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
    padding: 0 1;
    border: round $panel-lighten-1;
    border-title-align: left;
    background: $boost;
}

SelectionList:focus,
OptionList:focus {
    border: round $accent;
}

Collapsible {
    margin-bottom: 1;
    border: none;
}

Collapsible > CollapsibleTitle {
    color: $primary;
    text-style: bold;
}

Button {
    border: round $panel-lighten-1;
    margin-right: 1;
}

.section-heading {
    padding: 1 0 0 0;
    color: $primary;
    text-style: bold;
}

.panel-intro {
    padding-bottom: 1;
    color: $text-muted;
}

/* ── Readiness banner ──────────────────────────────────────────────── */

#config-problems {
    padding: 0 2;
    margin-top: 1;
    border: round $success;
    color: $text-muted;
}

#config-problems.blocking {
    border: round $warning;
    color: $warning;
}

/* ── Badges ────────────────────────────────────────────────────────── */

/* A short label on a solid colour, MovieBox's resolution chip. The text is
   the theme's darkest surface so it stays legible on every accent. */
.badge-gold    { background: $warning;      color: $background; text-style: bold; }
.badge-sapphire{ background: $primary;      color: $background; text-style: bold; }
.badge-teal    { background: $secondary;    color: $background; text-style: bold; }
.badge-lavender{ background: $accent;       color: $background; text-style: bold; }
.badge-success { background: $success;      color: $background; text-style: bold; }
.badge-error   { background: $error;        color: $background; text-style: bold; }
.badge-muted   { background: $panel;        color: $text-muted; }

/* ── Queue ─────────────────────────────────────────────────────────── */

#queue-header {
    height: auto;
    padding-bottom: 1;
}

#queue-summary {
    color: $text-muted;
}

/* Centred, with room above it. Flush against the top-left corner of an
   otherwise empty card, the line read as a label for something missing
   rather than as the state of the panel. */
#queue-empty {
    width: 100%;
    padding: 4 0;
    text-align: center;
    color: $text-disabled;
}

.track-row {
    height: 1;
    margin-bottom: 1;
}

.track-badge {
    width: 11;
    padding-right: 1;
}

.track-title {
    width: 40;
}

.track-bar {
    width: 1fr;
}

.track-row.completed .track-title { color: $success; }
.track-row.failed .track-title    { color: $error; }
.track-row.active .track-title    { text-style: bold; color: $text; }

ProgressBar > Bar > .bar--bar {
    color: $primary;
}

ProgressBar > Bar > .bar--complete {
    color: $success;
}

/* ── Command preview ───────────────────────────────────────────────── */

.command-panel {
    color: $text-muted;
}

/* ── Search, health, extensions ────────────────────────────────────── */

#search-query { margin-bottom: 1; }
#search-status,
#health-status,
#registry-status,
#session-status {
    padding: 1 0;
    color: $text-muted;
}

#search-results,
#health-table,
#registry-table {
    height: auto;
    max-height: 20;
    border: round $panel-lighten-1;
}

DataTable > .datatable--header {
    background: $panel;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $panel;
    color: $text;
    text-style: bold;
}

OptionList > .option-list--option-highlighted,
SelectionList > .option-list--option-highlighted {
    background: $panel;
    color: $text;
    text-style: bold;
}

#history-list,
#profile-list {
    max-height: 10;
}

#profile-name,
#registry-url {
    width: 1fr;
}

/* ── Log and status ────────────────────────────────────────────────── */

#log-pane {
    height: 14;
    margin: 0 1;
    border: round $panel;
    border-title-align: left;
}

#log {
    height: 1fr;
    padding: 0 1;
    background: $surface;
}

#status {
    height: 1;
    padding: 0 2;
    color: $text-muted;
}

#status.notice-info    { color: $primary; }
#status.notice-success { color: $success; }
#status.notice-warning { color: $warning; }
#status.notice-error   { color: $error; }

#hints {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $text-muted;
}

/* ── Modals ────────────────────────────────────────────────────────── */

HelpScreen,
CsvPickerScreen {
    align: center middle;
    background: $background 70%;
}

#help-box,
#csv-box {
    height: auto;
    max-height: 85%;
    padding: 1 3;
    border: round $primary;
    border-title-align: left;
    background: $surface;
}

#help-box { width: 74; max-width: 92%; }
#csv-box  { width: 84; max-width: 92%; }

.help-heading {
    padding: 1 0 0 0;
    color: $primary;
    text-style: bold;
}

.help-keys { padding: 1 0; }

.help-notes {
    padding: 1 0;
    color: $text-muted;
}

.help-footer {
    padding: 1 0 0 0;
    color: $text-disabled;
    text-align: center;
}

#csv-candidates {
    max-height: 12;
}

#csv-preview {
    padding: 1 0;
    color: $text-muted;
}

#quality-badge {
    margin: 0 0 1 30;
}

#no-providers {
    margin-bottom: 1;
    padding: 0 1;
    color: $warning;
}

/* ── Tracks ────────────────────────────────────────────────────────── */

#tracks-status {
    padding: 1 0;
    color: $text-muted;
}

#tracks-table {
    height: auto;
    max-height: 24;
    border: round $panel-lighten-1;
}

/* ── Toasts ────────────────────────────────────────────────────────── */

/* Textual's own notifications, restyled to MovieBox's: a bordered box in
   the bottom-right corner, its severity named in the border's colour, the
   message under it. Using the built-in rather than a hand-rolled rack buys
   stacking, timeouts and click-to-dismiss for nothing. */

Toast {
    width: 44;
    max-width: 50%;
    padding: 0 1;
    background: $surface;
    border: round $primary;
    border-title-align: left;
}

Toast .toast--title {
    text-style: bold;
    color: $text;
}

Toast.-information {
    border: round $primary;
}

Toast.-information .toast--title {
    color: $primary;
}

Toast.-warning {
    border: round $warning;
}

Toast.-warning .toast--title {
    color: $warning;
}

Toast.-error {
    border: round $error;
}

Toast.-error .toast--title {
    color: $error;
}
