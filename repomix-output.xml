        except Exception as e:
            self.log(f"Error fetching metadata: {e!s}", "error")
            self.set_progress("Error.")

    # ── Phase 2: Download ─────────────────────────────────────────────────────

    def download_tracks(self, selected_indices, config) -> None:
        threading.Thread(
            target=self._download_task,
