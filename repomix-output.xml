}

/* ── ARTIST VIEW: sections Albums + Tracks ── */
.artist-section-hdr {
  max-width: min(100%, 950px); margin: 16px auto 8px;
  padding: 0 14px;
  display: flex; align-items: center; justify-content: space-between;
}
.artist-section-hdr-title {
  font-size: 11px; font-weight: 800; text-transform: uppercase;
  letter-spacing: .08em; color: var(--muted);
}
.artist-section-hdr-count {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px; color: var(--muted);
}
.artist-albums-grid {
  max-width: min(100%, 950px); margin: 0 auto 4px;
  padding: 0 14px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 10px;
}
.artist-album-card {
  background: var(--surface); border: 1.5px solid var(--border);
  border-radius: 10px; overflow: hidden; cursor: pointer;
  transition: border-color var(--t), transform .15s, box-shadow .15s;
}
.artist-album-card:hover {
  border-color: var(--yellow); transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0,0,0,.1);
}
.aac-cover {
  width: 100%; aspect-ratio: 1; background: var(--surface2);
  display: flex; align-items: center; justify-content: center;
  font-size: 26px; overflow: hidden;
}
.aac-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
.aac-body { padding: 8px 10px 10px; }
.aac-name {
  font-size: 11.5px; font-weight: 700; color: var(--text);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 2px;
}
.aac-meta { font-size: 10px; color: var(--muted); }
/* ── ARTIST TABS ── */
.artist-tabs-bar {
  max-width: min(100%, 950px); margin: 14px auto 0;
  padding: 0 14px;
  display: flex; gap: 2px;
  border-bottom: 2px solid var(--border);
}
.artist-tab {
  padding: 8px 18px;
  font-size: 12.5px; font-weight: 700;
  color: var(--muted); background: none; border: none;
  border-bottom: 2px solid transparent; margin-bottom: -2px;
  cursor: pointer; font-family: var(--app-font);
  transition: color var(--t), border-color var(--t);
  white-space: nowrap;
}
.artist-tab:hover { color: var(--text2); }
.artist-tab.active { color: var(--text); border-bottom-color: var(--yellow); }

/* Gallery */
.artist-gallery-grid {
  max-width: min(100%, 950px); margin: 12px auto;
  padding: 0 14px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 10px;
}
.artist-gallery-img {
  width: 100%; aspect-ratio: 1; object-fit: cover;
  border-radius: 10px; border: 1.5px solid var(--border);
  cursor: pointer; transition: transform .15s, border-color var(--t);
  display: block;
}
.artist-gallery-img:hover { transform: scale(1.02); border-color: var(--yellow); }
.artist-gallery-empty {
  grid-column: 1 / -1; color: var(--muted);
  font-size: 13px; padding: 32px 0; text-align: center;
}

/* ── ARTIST CARD ENHANCEMENTS ── */
.artist-verified-badge {
  display: inline-flex; align-items: center; justify-content: center;
  vertical-align: middle; margin-left: 7px; flex-shrink: 0;
}
#album-subtitle.artist-bio {
  font-size: 12.5px; color: var(--text2); line-height: 1.6;
  display: -webkit-box; -webkit-line-clamp: 4; line-clamp: 4; -webkit-box-orient: vertical;
  overflow: hidden; margin-bottom: 8px;
}

/* =========================================
   RESPONSIVITY ADJUSTMENTS
   ========================================= */

@media (max-width: 900px) {
  .search-container { flex-direction: column; gap: 10px; height: auto; padding: 10px; }
  .url-wrap { width: 100%; }
  
  /* Nascondi Playcount e Duration in modo forzato sia nell'header che nelle righe */
  .track-table-header > div:nth-child(4),
  .track-table-header > div:nth-child(5),
  .track-row > div:nth-child(4),
  .track-row > div:nth-child(5) { 
    display: none !important; 
  }
  
  /* Layout updated per le 4 colonne rimanenti (Checkbox, #, Titolo, Azioni) */
  .track-table-header, .track-row { 
    grid-template-columns: 24px 30px 1fr 140px !important; 
  }
}

@media (max-width: 600px) {
  #main-split { flex-direction: column; }
  
  /* Nascondi anche l'indice (#) su smartphone */
  .track-table-header > div:nth-child(2),
  .track-row > div:nth-child(2) { 
    display: none !important; 
  }
  
  /* Layout per 3 colonne: Checkbox, Titolo, Azioni */
  .track-table-header, .track-row { 
    grid-template-columns: 24px 1fr 130px !important; 
  }
}

/* =========================================
   SKELETON ANIMATIONS
   ========================================= */
.skeleton {
  background: linear-gradient(90deg, var(--surface2) 25%, var(--border) 50%, var(--surface2) 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.5s infinite linear;
  border-radius: 4px;
}

@keyframes skeleton-pulse {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.skeleton-text { height: 16px; margin: 4px 0; width: 80%; border-radius: 4px; }
.skeleton-text.short { width: 40%; }
.skeleton-row { 
  display: grid; 
  grid-template-columns: 40px 30px 1fr 80px 80px 90px; 
  gap: 10px; 
  padding: 12px 10px; 
  border-bottom: 1px solid var(--border);
}

/* ── ffmpeg warning banner ── */
.ffmpeg-banner {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  background: rgba(239, 68, 68, .08);
  border-bottom: 1px solid rgba(239, 68, 68, .25);
  font-size: 12px;
  color: var(--text2);
  flex-shrink: 0;
  animation: fadein .2s ease;
}
.ffmpeg-banner-icon {
  font-size: 16px;
  flex-shrink: 0;
  color: var(--red);
}
.ffmpeg-banner-body {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
}
.ffmpeg-banner-body strong { color: var(--red); }
.ffmpeg-banner-link {
  color: var(--yellow);
  text-decoration: underline;
  white-space: nowrap;
}
.ffmpeg-banner-close {
  background: none;
  border: none;
  color: var(--muted);
  cursor: pointer;
  font-size: 14px;
  padding: 2px 6px;
  border-radius: 4px;
  flex-shrink: 0;
  transition: color var(--t);
}
.ffmpeg-banner-close:hover { color: var(--text2); }

/* --- EXPLORE VIEW --- */
.explore-section-title {
  font-size: 18px;
  font-weight: 600;
  margin: 24px 0 16px 0;
  color: var(--text);
}
.explore-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 16px;
  margin-bottom: 32px;
}
.explore-card {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}
.explore-card:hover {
  background: var(--surface3);
  transform: translateY(-3px);
}
.explore-card img {
  width: 100%;
  border-radius: 6px;
  aspect-ratio: 1/1;
