    .s-body { flex: 1; overflow-y: auto; padding: 14px 18px 18px; min-height: 0; }
    .s-body::-webkit-scrollbar { width: 3px; }
    .s-body::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 99px; }
    .s-footer { position: sticky; bottom: 0; display: flex; justify-content: flex-start; padding: 10px 0 0; background: transparent; }
    .save-toast {
      position: fixed; bottom: 24px; left: 24px;
      min-width: 220px; padding: 12px 16px;
      background: rgba(20,20,20,.95);
      color: #fff; border-radius: 12px;
      border: 1px solid rgba(255,255,255,.08);
      box-shadow: 0 18px 40px rgba(0,0,0,.25);
      font-size: 13px; font-weight: 600;
      z-index: 800;
      opacity: .98;
    }
    .save-toast.hidden { display: none; }
    .save-toast.show { display: block; }
    .tc { display: none; }
    .tc.active { display: block; }
    .s-section { background: var(--surface); border: 1.5px solid var(--border); border-radius: calc(var(--radius) + 4px); padding: 18px 18px 18px 20px; margin-bottom: 14px; box-shadow: 0 8px 24px rgba(0,0,0,.06); }
    .s-section:last-child { margin-bottom: 0; }
    .s-title { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: 12px; }
    .s-row { display: flex; align-items: center; justify-content: space-between; min-height: 30px; margin-bottom: 8px; gap: 10px; }
    .s-row:last-child { margin-bottom: 0; }
    .s-row label { display: flex; align-items: center; gap: 8px; cursor: pointer; }
    .s-label { color: var(--text2); font-size: 12.5px; font-weight: 500; flex-shrink: 0; }
    .s-label small { display: block; color: var(--muted); font-size: 10px; margin-top: 1px; font-family: 'JetBrains Mono', monospace; }
    .s-sep { height: 1px; background: var(--border); margin: 8px 0; }

    select, input[type="text"], input[type="password"], input[type="number"] {
      background: var(--surface); color: var(--text);
      border: 1.5px solid var(--border); border-radius: var(--radius-sm);
      padding: 6px 10px; outline: none;
      font-family: var(--app-font); font-size: 12.5px; cursor: pointer;
      transition: border-color var(--t);
    }
    select:focus, input:focus { border-color: var(--yellow); }
    input[type="number"] { width: 70px; text-align: center; }
    input[type="text"].full, input[type="password"].full { width: 100%; }

    /* Toggle */
    .toggle { position: relative; width: 36px; height: 20px; flex-shrink: 0; }
    .toggle input { opacity: 0; width: 0; height: 0; }
    .toggle-sl {
      position: absolute; inset: 0; background: var(--surface3);
      border-radius: 99px; border: 1.5px solid var(--border2); cursor: pointer;
      transition: background var(--t), border-color var(--t);
    }
    .toggle-sl::before {
      content: ''; position: absolute; width: 13px; height: 13px; left: 2px; top: 50%;
      transform: translateY(-50%); background: var(--muted); border-radius: 50%;
      transition: transform .2s, background var(--t);
    }
    .toggle input:checked + .toggle-sl { background: var(--yellow-bg); border-color: var(--yellow); }
    .toggle input:checked + .toggle-sl::before { transform: translateX(16px) translateY(-50%); background: var(--yellow); }

    /* Sortable lists */
    .sort-list { display: flex; flex-direction: column; gap: 4px; }
    #services-list {
      display: flex;
      flex-direction: column; /* Changed from row to column */
      flex-wrap: nowrap;      /* No longer wraps */
      gap: 6px;               /* Slightly more compact */
      width: 100%;            /* Takes full width */
    }

    #services-list .sort-item {
      width: 100%;            /* Occupa tutta la larghezza */
      flex: none;             /* Rimuovi il flex-grow */
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      transition: all var(--t);
    }
    .sort-item.inactive {
      opacity: 0.6;
      filter: grayscale(1);
    }
    .priority-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--muted);
      width: 20px;
      text-align: center;
      font-weight: 700;
    }
    .svc-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 36px; height: 36px; border-radius: 12px;
      background: var(--surface);
      border: none;
      flex-shrink: 0; overflow: hidden;
      color: var(--text);
    }
    .svc-icon.icon-image {
      background: var(--surface);
      border: none;
    }
    .svc-icon img {
      height: 20px; width: auto; max-width: 80%; object-fit: contain;
      display: block;
    }
    /* Fix visual size discrepancies for specific icons with extra whitespace */
    .svc-icon.kuwo img,
    .svc-icon.netease img {
      height: 24px; max-width: 90%; transform: scale(1.05); transform-origin: center;
    }
    .svc-icon.tidal,
    .svc-icon.qobuz,
    .svc-icon.deezer,
    .svc-icon.amazon,
    .svc-icon.soundcloud,
    .svc-icon.youtube,
    .svc-icon.apple,
    .svc-icon.pandora {
      background: var(--surface);
      color: var(--text);
    }
    .sort-item {
      display: flex; align-items: center; gap: 8px;
      padding: 7px 10px; background: var(--surface);
      border: 1.5px solid var(--border2); border-radius: var(--radius-sm);
      cursor: grab; transition: border-color var(--t), background var(--t);
    }
    .sort-item:hover { border-color: var(--border2); background: var(--surface2); }
    .sort-item.dragging  { opacity: .3; }
    .sort-item.drag-over { border-color: var(--yellow); background: var(--yellow-bg); }
    .drag-h { color: var(--muted); font-size: 12px; cursor: grab; }
    .svc-name  { flex: 1; font-size: 12.5px; color: var(--text2); }
    .svc-badge { font-family: 'JetBrains Mono', monospace; font-size: 9.5px; padding: 1.5px 5px; border-radius: 4px; background: var(--surface3); color: var(--muted); border: 1px solid var(--border); }

    .status-panel-header {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
      margin-bottom: 14px;
    }
    .status-toolbar {
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: flex-end;
    }
    .status-check-all {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 10px 18px; background: var(--yellow); color: #000;
      border: none; border-radius: 18px; font-family: var(--app-font); font-weight: 700;
      cursor: pointer; transition: opacity var(--t), transform var(--t);
    }
    .status-check-all:hover { opacity: .92; transform: translateY(-1px); }
    .status-overall {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 8px 14px; border-radius: 999px; border: 1px solid var(--border2);
      background: var(--surface2); color: var(--muted); font-size: 12px;
    }
    .status-overall.online { border-color: var(--green); background: rgba(34,197,94,.08); color: var(--green); }
    .status-overall.offline { border-color: var(--red); background: rgba(239,68,68,.08); color: var(--red); }
    .status-overall-icon {
      width: 20px; height: 20px; border-radius: 999px;
      display: inline-flex; align-items: center; justify-content: center;
      background: currentColor; color: #fff; font-size: 12px;
    }
    .status-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;
      margin-bottom: 6px;
    }
    .status-section-title {
      display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
      margin: 18px 0 12px; padding-top: 14px; border-top: 1px solid var(--border);
      font-size: 13px; font-weight: 700; color: var(--text);
    }
    .status-section-hint { font-size: 11px; font-weight: 400; color: var(--muted); }
    .status-grid-extensions { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .svc-icon.icon-glyph {
      font-size: 17px; background: var(--surface);
    }
    .svc-icon.extensions {
      background: var(--yellow-bg); color: var(--yellow);
    }
    /* Status card reduced and made more compact */
    .status-card {
      padding: 16px 18px; border-radius: 18px; background: var(--surface);
      border: 1px solid var(--border2); box-shadow: 0 12px 24px rgba(0,0,0,.04);
    }
    .status-card-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .status-card-left { display: flex; align-items: center; gap: 14px; min-width: 0; flex: 1; }
    .status-card-name { font-size: 15px; font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .status-icon-dot { flex-shrink: 0; font-weight: 600; }
    
    /* HC */
    .hc-prov-group { margin-bottom: 8px; }
    .hc-prov-name { font-size: 12px; font-weight: 700; color: var(--text2); display: flex; align-items: center; gap: 5px; margin-bottom: 4px; }
    .hc-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; background: var(--muted); }
    .hc-dot.ok { background: var(--green); }
    .hc-dot.err { background: var(--red); }
    .hc-row {
      display: flex; align-items: center; gap: 7px;
      padding: 4px 9px; margin-bottom: 3px;
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px;
    }
    .hc-row.ok-r  { border-left: 3px solid var(--green); }
    .hc-row.err-r { border-left: 3px solid var(--red); }
    .hc-ind    { font-size: 10px; flex-shrink: 0; }
    .hc-meth   { padding: 1px 5px; background: var(--surface3); border: 1px solid var(--border); border-radius: 4px; font-size: 9px; color: var(--muted); }
    .hc-url    { flex: 1; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hc-detail { color: var(--text2); flex-shrink: 0; max-width: 80px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hc-lat    { color: var(--muted); flex-shrink: 0; width: 60px; text-align: right; }
    .hc-lat.good { color: var(--green); }
    .hc-lat.slow { color: #fbbf24; }

    .hidden { display: none !important; }
    :focus-visible { outline: 2px solid var(--yellow); outline-offset: 2px; }

    /* ── Sidebar nav tooltips ── */
    #sidebar { overflow: visible; }
    .nav-btn[data-label] { position: relative; }
    .nav-btn[data-label]::after {
      content: attr(data-label);
      position: absolute;
      left: calc(100% + 10px);
      top: 50%; transform: translateY(-50%);
      background: var(--surface3);
      border: 1px solid var(--border2);
      color: var(--text);
      font-family: var(--app-font); font-size: 11.5px; font-weight: 600;
      padding: 5px 11px; border-radius: var(--radius-sm);
      white-space: nowrap; pointer-events: none;
      opacity: 0; transition: opacity .12s ease;
      z-index: 600;
      box-shadow: 0 4px 14px rgb(0, 0, 0);
    }
    .nav-btn[data-label]:hover::after { opacity: 1; }

    /* ── Action button feedback states ── */
    @keyframes ta-spin { to { transform: rotate(360deg); } }
    .ta-spin { animation: ta-spin .65s linear infinite; transform-origin: center; }
    .ta-btn.ta-loading, .act-btn.ta-loading {
      pointer-events: none;
      color: var(--text2) !important;
      border-color: var(--border2) !important;
      background: var(--surface2) !important;
    }
    .ta-btn.ta-state-success, .act-btn.ta-state-success {
      background: rgba(34,197,94,.12) !important;
      border-color: var(--green) !important;
      color: var(--green) !important;
      pointer-events: none;
    }
    .ta-btn.ta-state-error, .act-btn.ta-state-error {
      background: rgba(239,68,68,.12) !important;
      border-color: var(--red) !important;
      color: var(--red) !important;
      pointer-events: none;
    }

    
    .track-detail-card.hidden {
      display: none;
    }


    .track-detail-header {
      display: flex; justify-content: flex-end;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .track-detail-close {
      background: none; border: none;
      color: var(--muted); cursor: pointer;
      padding: 4px;
      display: flex; align-items: center; justify-content: center;
      transition: color var(--t);
    }
    .track-detail-close:hover { color: var(--text2); }

    .track-detail-body {
      display: flex;
      gap: 24px;
