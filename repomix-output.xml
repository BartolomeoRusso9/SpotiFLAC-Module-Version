            or "/c/" in lower_url
            or "/@" in lower_url
            or "/browse/" in lower_url
        ):
            is_blocked = True

        elif "soundcloud.com" in lower_url:
            path = urlparse(url).path.strip("/")
            parts = [p for p in path.split("/") if p]
