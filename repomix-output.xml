    is_soundcloud_url = (
        "soundcloud.com" in cfg["url"] or "on.soundcloud.com" in cfg["url"]
    )
    is_apple_url = "music.apple.com" in cfg["url"]
    is_youtube_url = (
        "youtube.com" in cfg["url"].lower() or "youtu.be" in cfg["url"].lower()
    )
