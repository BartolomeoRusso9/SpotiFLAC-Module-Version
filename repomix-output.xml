            cfg["output_path"] = _ask(
                "Full file path including extension",
                cfg.get("output_path", ""),
            )
        else:
            cfg["output_path"] = None
    else:
        cfg["output_path"] = None

    # ── 3. Services ──────────────────────────────────────────────────────────
    _section("3 · Audio Services")

    if health_status:
