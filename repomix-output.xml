<file path=".github/workflows/build-release.yml">
name: Build and Release SpotiFLAC

permissions:
  contents: write

on:
  workflow_dispatch:
    inputs:
      version_tag:
        description: 'Name of the version tag (es: v1.0.0)'
        required: false
        type: string

jobs:
  lint-and-bump:
    runs-on: ubuntu-latest
    outputs:
      release_tag: ${{ steps.commit_and_bump.outputs.NEW_TAG }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v5
        with:
          fetch-depth: 0

      - name: Setup Python
        uses: actions/setup-python@v6
        with:
          python-version: '3.12'

      - name: Install dev dependencies
        shell: bash
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements-dev.txt ]; then pip install -r requirements-dev.txt; fi
          pip install .

      - name: Auto-fix with ruff and black
        shell: bash
        run: |
          if command -v ruff >/dev/null 2>&1; then
            if ! ruff check --fix .; then
              echo "::warning::Ruff found remaining issues after automatic fixes; continuing with the release build."
            fi
          else
            echo "ruff not installed"
          fi
          if command -v black >/dev/null 2>&1; then black .; else echo "black not installed"; fi

      - name: Commit changes and bump version
        id: commit_and_bump
        shell: bash
        run: |
          # 1. Commit delle modifiche di formattazione (se esistono)
          if [[ -n "$(git status --porcelain)" ]]; then
            echo "Format changes detected. Committing..."
            git config --global user.name "github-actions[bot]"
            git config --global user.email "41898282+github-actions[bot]@users.noreply.github.com"
            
            git add .
            git commit -m "style: auto-fix ruff e black [skip ci]"
            git push origin HEAD:${{ github.ref }}
          else
            echo "No formatting changes detected. Moving straight to versioning."
          fi
          
          # 2. Calcolo del nuovo Tag (Manuale o Automatico)
          USER_INPUT="${{ github.event.inputs.version_tag }}"
          if [[ -n "$USER_INPUT" ]]; then
            echo "Using manually provided tag: $USER_INPUT"
            NEW_TAG="$USER_INPUT"
          else
            # Recupera i tag per far funzionare correttamente 'git describe'
            git fetch --tags
            LATEST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "v1.0.0")
            
            if [[ $LATEST_TAG =~ ^v?([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
              MAJOR="${BASH_REMATCH[1]}"
              MINOR="${BASH_REMATCH[2]}"
              PATCH="${BASH_REMATCH[3]}"
              
              NEW_PATCH=$((PATCH + 1))
              NEW_TAG="v$MAJOR.$MINOR.$NEW_PATCH"
              echo "Auto-bumping from $LATEST_TAG to $NEW_TAG"
            else
              NEW_TAG="v1.0.1" 
              echo "Regex failed on $LATEST_TAG. Falling back to default: $NEW_TAG"
            fi
          fi
          
          # 3. Creazione e Push del Tag
          if git rev-parse "$NEW_TAG" >/dev/null 2>&1; then
            echo "Tag $NEW_TAG already exists. Moving it to the current commit..."
            git tag -f "$NEW_TAG"
            git push origin -f "$NEW_TAG"
          else
            echo "Creating new tag: $NEW_TAG"
            git tag "$NEW_TAG"
            git push origin "$NEW_TAG"
          fi
          
          # 4. Output per il job di Release
          echo "NEW_TAG=$NEW_TAG" >> $GITHUB_OUTPUT

  build:
    needs: lint-and-bump
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: windows-latest
            arch: x86_64
            artifact_name: SpotiFLAC-Windows.exe
            build_name: SpotiFLAC-Windows

          - os: macos-latest
            arch: x86_64
            artifact_name: SpotiFLAC-macOS
            build_name: SpotiFLAC-macOS

          - os: ubuntu-latest
            arch: x86_64
            artifact_name: SpotiFLAC-Linux-x86_64
            build_name: SpotiFLAC-Linux-x86_64

          - os: ubuntu-latest
            arch: arm64
            artifact_name: SpotiFLAC-Linux-arm64
            build_name: SpotiFLAC-Linux-arm64

    runs-on: ${{ matrix.os }}

    steps:
    - name: Checkout code
      uses: actions/checkout@v5
      with:
        ref: refs/tags/${{ needs.lint-and-bump.outputs.release_tag }}

    - name: Setup Python
      if: matrix.arch == 'x86_64'
      uses: actions/setup-python@v6
      with:
        python-version: '3.12'

    - name: Install dependencies (x86_64 / macOS / Linux)
      if: matrix.arch == 'x86_64'
      shell: bash
      run: |
        python -m pip install --upgrade pip
        pip install pyinstaller certifi requests mutagen
        pip install .

    - name: Build SpotiFLAC (x86_64 / macOS / Linux)
      if: matrix.arch == 'x86_64'
      shell: bash
      run: |
        cd SpotiFLAC
        pyinstaller --onefile --name "${{ matrix.build_name }}" --console ../launcher.py

    - name: Setup QEMU for ARM64
      if: matrix.arch == 'arm64'
      uses: docker/setup-qemu-action@v3
      with:
        platforms: arm64

    - name: Build ARM64 Linux via Docker
      if: matrix.arch == 'arm64'
      shell: bash
      run: |
        docker run --rm --platform linux/arm64 \
          -v "$PWD":/workspace \
          -w /workspace python:3.12-bullseye \
          bash -c "
            pip install --upgrade pip && \
            pip install pyinstaller certifi requests mutagen && \
            pip install . && \
            cd SpotiFLAC && \
            pyinstaller --onefile --name '${{ matrix.build_name }}' --console ../launcher.py
          "

    - name: Upload build artifact
      uses: actions/upload-artifact@v4
      with:
        name: bin-${{ matrix.build_name }}
        path: SpotiFLAC/dist/${{ matrix.artifact_name }}
        retention-days: 7

  release:
      needs: [lint-and-bump, build]
      runs-on: ubuntu-latest
      if: github.event_name == 'workflow_dispatch' || startsWith(github.ref, 'refs/tags/v')
      
      steps:
        - name: Checkout code (For Changelog Generation)
          uses: actions/checkout@v5
          with:
            fetch-depth: 0
            ref: refs/tags/${{ needs.lint-and-bump.outputs.release_tag }}

        - name: Setup Python for AI
          uses: actions/setup-python@v6
          with:
            python-version: '3.12'

        - name: Download all build artifacts
          uses: actions/download-artifact@v4
          with:
            pattern: bin-*
            path: release-files
            merge-multiple: true

        - name: Generate AI Changelog
          env:
            GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          run: |
            pip install google-genai
            python -c "
            import os, subprocess
            from google import genai
            
            # Inizializza il client con il nuovo SDK
            client = genai.Client(api_key=os.environ['GEMINI_API_KEY'])
            
            try:
                # Recupera i commit effettuati dal tag precedente a quello attuale
                cmd = 'git log \$(git describe --tags --abbrev=0 HEAD^ 2>/dev/null || git rev-list --max-parents=0 HEAD)..HEAD --pretty=format:\"- %s\"'
                commits = subprocess.check_output(cmd, shell=True).decode('utf-8')
            except Exception:
                commits = subprocess.check_output('git log -10 --pretty=format:\"- %s\"', shell=True).decode('utf-8')
                
            if not commits.strip(): 
                commits = '- Maintenance and minor updates'
            
            # Prompt avanzato per generare note di rilascio altamente tecniche
            prompt = f'''You are an expert software engineer and technical writer. Review the following commit logs:
            {commits}
            
            Generate highly technical, professional release notes in Markdown format. Organize the changelog strictly into the following sections: **New Features**, **Bug Fixes**, and **Maintenance**.
            
            **Guidelines for technical depth:**
            *   **Use specific technical terminology:** Describe changes at the code, architecture, or system level (e.g., specify API endpoints modified, database schema migrations, specific design patterns used, or algorithmic optimizations).
            *   **Do not simplify:** Avoid abstracting the changes into layman's terms or user-centric language. The target audience is senior developers and DevOps engineers. 
            *   **Be precise:** Mention the exact libraries, variables, or system components affected if present in the commit messages.
            *   **Filter noise:** Ignore automated system commits, merge commits, version bumps, and trivial typo fixes. 
            *   **Tone:** Strictly professional and objective. DO NOT use emojis.'''
            
            # Genera il contenuto usando la nuova sintassi
            response = client.models.generate_content(
                model='gemini-flash-latest',
                contents=prompt
            )
            
            with open('ai_changelog.md', 'w', encoding='utf-8') as f:
                f.write(response.text)
            "

        - name: Prepare Final Release Body
          run: |
            cat << 'EOF' > release_body.md
            ## Changelog
            
            EOF
            
            cat ai_changelog.md >> release_body.md
            
            cat << 'EOF' >> release_body.md
            
            ### WORKING APIs

            ## Downloads
            
            [![Windows](https://img.shields.io/badge/Windows-[SPOTIFLAC.EXE]-0078D6?style=for-the-badge&logo=data:image/svg+xml;base64,)](https://github.com/${{ github.repository }}/releases/download/${{ needs.lint-and-bump.outputs.release_tag }}/SpotiFLAC-Windows.exe) [![macOS](https://img.shields.io/badge/macOS-[SPOTIFLAC--macos]-000000?style=for-the-badge&logo=apple&logoColor=white)](https://github.com/${{ github.repository }}/releases/download/${{ needs.lint-and-bump.outputs.release_tag }}/SpotiFLAC-macOS) [![Linux](https://img.shields.io/badge/Linux-[SPOTIFLAC--linux]-FFB300?style=for-the-badge&logo=linux&logoColor=black)](https://github.com/${{ github.repository }}/releases/download/${{ needs.lint-and-bump.outputs.release_tag }}/SpotiFLAC-Linux-x86_64)

            <details>
            <summary><b>💻 Usage Instructions</b></summary>
            
            ### Windows (PowerShell ou CMD)
            ```cmd
            SpotiFLAC-Windows.exe [https://open.spotify.com/track/](https://open.spotify.com/track/)... ./out --service tidal
            ```

            ### 🍏 macOS
            ```bash
