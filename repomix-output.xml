#!/usr/bin/env python3
"""Aggiorna gli sha256 nei registry scaricandone le estensioni e ricalcolando i checksum.

Uso:
  python3 scripts/update_registry_shas.py

Risultato:
  Crea file `registry-fixed-<n>.json` nella cartella corrente con gli sha aggiornati.
"""
from __future__ import annotations

import hashlib
import json
import os
import sys
import urllib.request
from urllib.parse import urlparse


REG_ENV = "SPOTIFLAC_REGISTRIES"
ENV_FILES = (os.path.join(os.getcwd(), ".env"), os.path.expanduser("~/.spotiflac_env"))


def read_registries_from_env() -> list[str]:
    val = os.environ.get(REG_ENV)
    if val:
        return [u.strip() for u in val.split(",") if u.strip()]
    for p in ENV_FILES:
        try:
            if os.path.exists(p):
                with open(p, "r", encoding="utf-8") as f:
                    for ln in f:
                        ln = ln.strip()
                        if ln.startswith(f"{REG_ENV}="):
                            _, v = ln.split("=", 1)
                            return [u.strip() for u in v.split(",") if u.strip()]
        except Exception:
            continue
    return []


def fetch_url_bytes(url: str) -> bytes:
    req = urllib.request.Request(url, headers={"User-Agent": "SpotiFLAC-Agent"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.read()


def compute_sha256(data: bytes) -> str:
    h = hashlib.sha256()
    h.update(data)
    return h.hexdigest()


def main() -> int:
    urls = read_registries_from_env()
    if not urls:
        print("Nessuna registry configurata (SPOTIFLAC_REGISTRIES). Modifica .env o esporta la variabile.")
        return 2

    out_files = []
    for idx, u in enumerate(urls, start=1):
        print(f"Processing registry: {u}")
        try:
            raw = fetch_url_bytes(u)
            data = json.loads(raw.decode("utf-8"))
        except Exception as e:
            print(f"  Errore scaricando/parsing registry {u}: {e}")
            continue

        changed = 0
        exts = data.get("extensions", [])
        for ext in exts:
            durl = ext.get("download_url")
            if not durl:
                continue
            try:
                print(f"  Downloading {ext.get('id')} from {durl}...", end=" ")
                b = fetch_url_bytes(durl)
                sha = compute_sha256(b)
                prev = (ext.get("sha256") or "").lower()
                if sha != prev:
                    print(f"mismatch (prev={prev[:8]}.. -> new={sha[:8]}..)")
                    ext["sha256"] = sha
                    changed += 1
                else:
                    print("ok")
            except Exception as e:
                print(f"failed: {e}")
                continue

        out_name = f"registry-fixed-{idx}.json"
        try:
            with open(out_name, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2, ensure_ascii=False)
            out_files.append((out_name, changed))
        except Exception as e:
            print(f"  Errore scrivendo {out_name}: {e}")

    print("\nSummary:")
    for name, changed in out_files:
        print(f"  {name}: {changed} entries updated")

    if not out_files:
        print("Nessun registry processato con successo.")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
