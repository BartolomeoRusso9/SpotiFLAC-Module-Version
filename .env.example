# Example environment configuration for Mornye
# Copy this file to .env and edit values as needed.

# Comma-separated list of registry JSON URLs (used by ExtensionManager)
# No registry is bundled; add comma-separated registry URLs here.
MORNYE_REGISTRIES=

# Optional: comma-separated list of *directory* JSON URLs — a directory
# lists registries (for you to review and add yourself via
# MORNYE_REGISTRIES/--registries), rather than extensions directly. See
# extensions/directories.py and the GUI's Discover screen. Like registries,
# nothing is bundled: this is empty unless you point it at one yourself.
MORNYE_REGISTRY_DIRECTORIES=

# Optional: path to a file containing extension download URLs (one per line).
# If set, ExtensionManager.install_from_links_file will use this path.
MORNYE_EXT_LINKS=

# Optional: custom extensions directory (absolute or relative). If empty,
# the default ~/.mornye/extensions will be used.
MORNYE_EXT_DIR=

# Optional: where Mornye keeps its database, extensions, signed sessions
# and settings (default ~/.mornye), and where downloads go when no folder
# is given (default ~/Music/Mornye). Mainly for Docker, where neither
# should depend on $HOME — see docs/guide/docker.md.
MORNYE_DATA_DIR=
MORNYE_DOWNLOAD_DIR=

# Optional: enable animated album artwork by default and choose the
# Apple Music Animated Artworks API (the public instance is used by default).
MORNYE_ANIMATED_ARTWORKS_ENABLED=0
MORNYE_ANIMATED_ARTWORKS_API_URL=https://artwork.m8tec.top

# Docker only: the user the container runs as (see docker-compose.example.yml).
# PUID=1000
# PGID=1000

# Any other env variables used by the application can go here.
# Copy this file as .env and fill values as needed.
# Load with: export $(cat .env | xargs)

# Optional VNC password for Docker/browser access.
# If unset, the container starts x11vnc without a fixed password.
# Example:
# X11VNC_PASSWORD=change_me_securely
X11VNC_PASSWORD=

# Optional QOBUZ local API endpoint.
# Leave http://localhost:8000 if you use default settings.
QOBUZ_LOCAL_API_URL=http://localhost:8000